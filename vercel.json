{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "vite-project/",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "Backend/",
      "framework": "express",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/login",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/register",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/blog",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/contact",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/blogs",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/blogs/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/contacts",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
